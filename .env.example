# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Get these from https://sanity.io/manage → your project → API

# Project ID (public — safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# API token with "Editor" role — server-side only, never expose to the browser
# Generate at: sanity.io/manage → API → Tokens → Add API token
SANITY_API_TOKEN=

# ─── Once UI / Portfolio ───────────────────────────────────────────────────────

# Password to protect specific routes (e.g. /work/private-project)
# Leave empty to disable password protection
PAGE_ACCESS_PASSWORD=
